@model IEnumerable<Portal_Web_Colegio.Models.Expediente>

@{
    ViewData["Title"] = "Expedientes";
}

<h1>Expedientes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar expediente</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Materia</th>
            <th>Docente</th>
            <th>@Html.DisplayNameFor(model => model.NotaFinal)</th>
            <th>@Html.DisplayNameFor(model => model.Observaciones)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Alumno?.Apellido, @item.Alumno?.Nombre</td>
                <td>@item.Materia?.NombreMateria</td>
                <td>@item.Materia?.Docente</td>
                <td>@item.NotaFinal.ToString("0.00")</td>
                <td>@Html.DisplayFor(modelItem => item.Observaciones)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ExpedienteId" class="btn btn-sm btn-warning">Corregir</a>
                    <a asp-action="Details" asp-route-id="@item.ExpedienteId" class="btn btn-sm btn-info">Ver ficha</a>
                    <a asp-action="Delete" asp-route-id="@item.ExpedienteId" class="btn btn-sm btn-danger">Quitar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay expedientes registrados.
    </div>
}
