@model IEnumerable<Portal_Web_Colegio.Models.Alumno>

@{
    ViewData["Title"] = "Estudiantes";
}

<h1>Estudiantes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar estudiante</a>
    <a asp-action="PromedioNotas" class="btn btn-outline-secondary">Promedio de calificaciones</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Apellido)</th>
            <th>@Html.DisplayNameFor(model => model.FechaNacimiento)</th>
            <th>@Html.DisplayNameFor(model => model.Grado)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                <td>@item.FechaNacimiento.ToString("yyyy-MM-dd")</td>
                <td>@Html.DisplayFor(modelItem => item.Grado)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AlumnoId" class="btn btn-sm btn-warning">Corregir</a>
                    <a asp-action="Details" asp-route-id="@item.AlumnoId" class="btn btn-sm btn-info">Ver ficha</a>
                    <a asp-action="Delete" asp-route-id="@item.AlumnoId" class="btn btn-sm btn-danger">Dar de baja</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay estudiantes registrados.
    </div>
}
