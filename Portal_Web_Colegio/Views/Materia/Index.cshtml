@model IEnumerable<Portal_Web_Colegio.Models.Materia>

@{
    ViewData["Title"] = "Materias";
}

<h1>Materias</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Agregar materia</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NombreMateria)</th>
            <th>@Html.DisplayNameFor(model => model.Docente)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NombreMateria)</td>
                <td>@Html.DisplayFor(modelItem => item.Docente)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MateriaId" class="btn btn-sm btn-warning">Corregir</a>
                    <a asp-action="Details" asp-route-id="@item.MateriaId" class="btn btn-sm btn-info">Ver ficha</a>
                    <a asp-action="Delete" asp-route-id="@item.MateriaId" class="btn btn-sm btn-danger">Quitar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay materias registradas.
    </div>
}
